# Dependencies
node_modules/
.venv/
venv/
__pycache__/
*.py[cod]

# Build output
dist/
build/
target/
*.egg-info/
.next/
.cache/

# Environment & secrets
.env
.env.*
!.env.example

# Editor & OS
.DS_Store
*.swp
*~
.idea/
.vscode/

# Logs
*.log
npm-debug.log*

# Blender / build artifacts
*.blend1
__pycache__/
build/renders/
# *.glb exports are ignored, EXCEPT the baked asset library below
*.glb

# never commit credentials
.git-credentials
*.token

# vendored toolchain IS committed (split tarball, see tools/setup_env.sh)
!vendor/
!vendor/blender/*

# raw scans are huge; only the baked library is committed
assets/raw/
assets/models/

# the baked library is the whole point of the bake step - always commit it
!assets/lib/
!assets/lib/*.glb
